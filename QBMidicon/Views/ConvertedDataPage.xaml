<Page
    x:Class="QBMidicon.Views.ConvertedDataPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resLocal="clr-namespace:QBMidicon.Properties"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:libQB.Behaviors;assembly=libQB"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="{StaticResource MediumLeftMargin}"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ContentControl
                Margin="8,2,0,0"
                Focusable="False"
                Content="{StaticResource ConvertedDataPageIcon}" />
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Margin="{StaticResource MediumLeftMargin}"
                Text="{x:Static resLocal:Resources.Title_ConvertedDataPage}" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <DataGrid
                Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Tracks}"
                SelectionMode="Single">
                <bh:Interaction.Behaviors>
                    <behaviors:DataGridExtendBehavior
                        SelectedRow="{Binding SelectedTrack}" />
                </bh:Interaction.Behaviors>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="Show Detail"
                            Command="{Binding ShowTrackDetailCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="40"
                        Header="No"
                        Binding="{Binding TrackNumber, Converter={StaticResource Increment}}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Right" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="300"
                        Header="Track Name"
                        Binding="{Binding TrackName}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="40"
                        Header="CH"
                        Binding="{Binding Channel}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Right" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="45"
                        Header="Vol"
                        Binding="{Binding Converter={StaticResource VolumeConverter}}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Right" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="45"
                        Header="Pan"
                        Binding="{Binding Converter={StaticResource PanConverter}}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Center" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="60"
                        Header="Events"
                        Binding="{Binding EventCount, StringFormat=N0}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Right" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn
                        Width="60"
                        Header="Drum"
                        Binding="{Binding IsDrum, Mode=OneWay}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="60"
                        Header="Lyric %"
                        Binding="{Binding LyricMatchRatio, StringFormat=0.0}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="{x:Type DataGridCell}"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="HorizontalAlignment"
                                    Value="Stretch" />
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Right" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn
                        Width="60"
                        Header="Lyric"
                        Binding="{Binding LyricMatched}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="80"
                        Header="Note Range"
                        Binding="{Binding Converter={StaticResource PitchRangeConverter}}"
                        IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style
                                TargetType="DataGridCell"
                                BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                <Setter
                                    Property="TextBlock.TextAlignment"
                                    Value="Center" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn
                        Width="90"
                        Header="Transpose"
                        IsReadOnly="False">
                        <!-- 表示用 -->
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Transpose}" 
                                    Visibility="{Binding CanTranspose, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    Width="80"
                                    ItemsSource="{Binding Source={StaticResource OctaveTransposeComboSource}}"
                                    SelectedItem="{Binding Transpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding CanTranspose, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
