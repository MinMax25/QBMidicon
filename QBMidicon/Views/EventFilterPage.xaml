<Page
    x:Class="QBMidicon.Views.EventFilterPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:properties="clr-namespace:QBMidicon.Properties"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
  
  <Page.Resources>
    <Style TargetType="ListBox" BasedOn="{StaticResource MahApps.Styles.ListBox}">
      <Setter Property="Width" Value="240"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource MahApps.Styles.GroupBox}">
      <Setter Property="Width" Value="240"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
      
        <StackPanel Grid.Row="0" Margin="{StaticResource MediumLeftMargin}" VerticalAlignment="Center" Orientation="Horizontal">
            <ContentControl Margin="8,2,0,0" Focusable="False" Content="{StaticResource EventFilterPageIcon}"/>
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Margin="{StaticResource MediumLeftMargin}"
                Text="{x:Static properties:Resources.Title_EventFilterPage}" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <DockPanel>
                <GroupBox Header="Meta">
                  <ListBox ItemsSource="{Binding FilterMeta}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </GroupBox>

                <GroupBox Header="Channel Voice">
                  <ListBox ItemsSource="{Binding FilterChannelVoice}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </GroupBox>

                <GroupBox Header="SysEx">
                  <ListBox ItemsSource="{Binding FilterSysEx}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </GroupBox>

                <GroupBox Header="Control Change">
                  <ListBox ItemsSource="{Binding FilterControlChange}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Key}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </GroupBox>
              </DockPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
    </Grid>
</Page>
