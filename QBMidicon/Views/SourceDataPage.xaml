<Page
    x:Class="QBMidicon.Views.SourceDataPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resLocal="clr-namespace:QBMidicon.Properties"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:libQB.Behaviors;assembly=libQB"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource MediumLeftMargin}" VerticalAlignment="Center" Orientation="Horizontal">
            <ContentControl Margin="8,2,0,0" Focusable="False" Content="{StaticResource SourceDataPageIcon}"/>
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Margin="{StaticResource MediumLeftMargin}"
                Text="{x:Static resLocal:Resources.Title_SourceDataPage}" />
        </StackPanel>
        
        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Header="File Info" Style="{StaticResource GroupBoxBaseStyle}">
                    <GroupBox.Resources>
                        <Style TargetType="Label" BasedOn="{StaticResource MahApps.Styles.Label}">
                            <Setter Property="Width" Value="80"/>
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </GroupBox.Resources>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Path"/>
                            <TextBlock Grid.Column="0" Text="{Binding FilePath}"/>
                            <Button Style="{StaticResource ButtonBaseStyle}" Margin="8,0,0,0" Content="Reload" Command="{Binding ReloadCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Format"/>
                            <TextBlock Text="{Binding Format}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Track Count"/>
                            <TextBlock Text="{Binding NumberOfTracks}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Division"/>
                            <TextBlock Text="{Binding Division}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="MIDI Type"/>
                            <TextBlock Text="{Binding MidiStd}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <TabControl Grid.Row="1">
                    <TabControl.Resources>
                        <DataTemplate x:Key="HeaderFontTemplate">
                            <TextBlock Text="{Binding}" FontSize="16"/>
                        </DataTemplate>
                    </TabControl.Resources>
                    <TabItem Header="Tracks" HeaderTemplate="{StaticResource HeaderFontTemplate}">
                        <DataGrid Style="{StaticResource DataGridStyle}" IsReadOnly="True" ItemsSource="{Binding Tracks}" SelectionMode="Single">
                            <bh:Interaction.Behaviors>
                                <behaviors:DataGridExtendBehavior SelectedRow="{Binding SelectedTrack}"/>
                            </bh:Interaction.Behaviors>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Show Detail" Command="{Binding ShowTrackDetailCommand}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="40" Header="No" Binding="{Binding TrackNumber, Converter={StaticResource Increment}}" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="300" Header="Track Name" Binding="{Binding}" IsReadOnly="True"/>
                                <DataGridTextColumn Width="40" Header="CH" Binding="{Binding Channel}" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="60" Header="Events" Binding="{Binding Events.Count, StringFormat=N0}" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Tempo" HeaderTemplate="{StaticResource HeaderFontTemplate}">
                        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Tempo}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Measure" Binding="{Binding Converter={StaticResource BreakedTimeConverter}}"/>
                                <DataGridTextColumn Header="Ticks" Binding="{Binding AbsoluteTick}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Message" Binding="{Binding Converter={StaticResource MidiMessageConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Key" HeaderTemplate="{StaticResource HeaderFontTemplate}">
                        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Key}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Measure" Binding="{Binding Converter={StaticResource BreakedTimeConverter}}"/>
                                <DataGridTextColumn Header="Ticks" Binding="{Binding AbsoluteTick}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Message" Binding="{Binding Converter={StaticResource MidiMessageConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Lyric" HeaderTemplate="{StaticResource HeaderFontTemplate}">
                        <ScrollViewer>
                            <TextBlock Text="{Binding Lyric}"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="SRT" HeaderTemplate="{StaticResource HeaderFontTemplate}">
                        <ScrollViewer>
                            <TextBlock Text="{Binding SRT}"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Page>
