<Page
    x:Class="QBMidicon.Views.ConvertSettingPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:resLocal="clr-namespace:QBMidicon.Properties"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="{StaticResource MediumLeftMargin}"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ContentControl
                Margin="8,2,0,0"
                Focusable="False"
                Content="{StaticResource ConvertSettingPageIcon}" />
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Margin="{StaticResource MediumLeftMargin}"
                Text="{x:Static resLocal:Resources.Title_ConvertSettingPage}" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>
                <StackPanel.Resources>
                    <Style
                        TargetType="CheckBox"
                        BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                    </Style>
                    <Style
                        TargetType="ComboBox"
                        BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                    </Style>
                    <Style
                        TargetType="TextBlock"
                        BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                        <Setter
                            Property="VerticalAlignment"
                            Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <GroupBox
                    Header="Common"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="Channel Fix"
                            IsChecked="{Binding ChannelFix}" />
                        <CheckBox
                            Content="Insert Track Name"
                            IsChecked="{Binding InsertTrackName}" />
                        <CheckBox
                            Content="Remove Program Change"
                            IsChecked="{Binding RemoveProgramChange}" />
                        <CheckBox
                            Content="Replace Note On"
                            IsChecked="{Binding ReplaceNoteOn}" />
                        <CheckBox
                            Content="Create Code Track"
                            IsChecked="{Binding CreateCodeTrack}" />
                        <TextBlock
                            Text="Text Encoding" />
                        <ComboBox
                            HorizontalAlignment="Left"
                            Width="100"
                            SelectedValue="{Binding Encode}"
                            ItemsSource="{Binding Source={StaticResource SMFEncodeComboSource}}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="Lyric"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="Adjustment"
                            IsChecked="{Binding LyricAdjustment}" />
                        <CheckBox
                            Content="Padding Plus"
                            IsChecked="{Binding LyricPaddingPlus}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="SRT"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <StackPanel
                            Orientation="Horizontal">
                            <Label
                                Width="80"
                                Content="SRT Offset" />
                            <TextBox
                                Width="50"
                                d:Text="500"
                                Text="{Binding SRTOffset}" />
                        </StackPanel>
                        <CheckBox
                            Content="Remove Comment"
                            IsChecked="{Binding SRTRemoveComment}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="XF Option"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="XFStyle Convert"
                            IsChecked="{Binding XFStyleConvert}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
