<Page
    x:Class="QBMidicon.Views.ConvertSettingPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:libQB.Localization;assembly=libQB"
    xmlns:p="clr-namespace:QBMidicon"
    xmlns:resLocal="clr-namespace:QBMidicon"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="48" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="{StaticResource MediumLeftMargin}"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ContentControl
                Margin="8,2,0,0"
                Focusable="False"
                Content="{StaticResource ConvertSettingPageIcon}" />
            <TextBlock
                Style="{StaticResource PageTitleStyle}"
                Margin="{StaticResource MediumLeftMargin}"
                Text="{loc:Loc Key={x:Static p:Resources.Title_ConvertSettingPage}}" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            Margin="{StaticResource MediumLeftRightMargin}"
            Background="{DynamicResource MahApps.Brushes.Gray10}">
            <StackPanel>
                <StackPanel.Resources>
                    <Style
                        TargetType="CheckBox"
                        BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                    </Style>
                    <Style
                        TargetType="ComboBox"
                        BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                    </Style>
                    <Style
                        TargetType="TextBlock"
                        BasedOn="{StaticResource MahApps.Styles.TextBlock}">
                        <Setter
                            Property="Margin"
                            Value="4" />
                        <Setter
                            Property="VerticalAlignment"
                            Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <GroupBox
                    Header="{loc:Loc Key={x:Static p:Resources.Common_Common}}"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_ChannelFix}}"
                            IsChecked="{Binding ChannelFix}" />
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_InsertTrackName}}"
                            IsChecked="{Binding InsertTrackName}" />
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_RemoveProgramChange}}"
                            IsChecked="{Binding RemoveProgramChange}" />
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_ReplaceNoteOn}}"
                            IsChecked="{Binding ReplaceNoteOn}" />
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_CreateCodeTrack}}"
                            IsChecked="{Binding CreateCodeTrack}" />
                        <TextBlock
                            Text="{loc:Loc Key={x:Static p:Resources.Convert_TextEncoding}}" />
                        <ComboBox
                            HorizontalAlignment="Left"
                            Width="100"
                            SelectedValue="{Binding Encode}"
                            ItemsSource="{Binding Source={StaticResource SMFEncodeComboSource}}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="{loc:Loc Key={x:Static p:Resources.Common_Lyric}}"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_Adjustment}}"
                            IsChecked="{Binding LyricAdjustment}" />
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_PaddingPlus}}"
                            IsChecked="{Binding LyricPaddingPlus}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="{loc:Loc Key={x:Static p:Resources.Common_SRT}}"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <StackPanel
                            Orientation="Horizontal">
                            <Label
                                Width="80"
                                Content="{loc:Loc Key={x:Static p:Resources.Convert_SRTOffset}}" />
                            <TextBox
                                Width="50"
                                d:Text="500"
                                Text="{Binding SRTOffset}" />
                        </StackPanel>
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_RemoveComment}}"
                            IsChecked="{Binding SRTRemoveComment}" />
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Header="{loc:Loc Key={x:Static p:Resources.Convert_XFOption}}"
                    Style="{StaticResource GroupBoxBaseStyle}">
                    <StackPanel
                        HorizontalAlignment="Left">
                        <CheckBox
                            Content="{loc:Loc Key={x:Static p:Resources.Convert_XFStyleConvert}}"
                            IsChecked="{Binding XFStyleConvert}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
