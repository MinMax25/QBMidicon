<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:libQB="clr-namespace:libQB.Enums;assembly=libQB"
    xmlns:SMF="clr-namespace:libMidi.SMF;assembly=libMidi"
    xmlns:SMFEnum="clr-namespace:libMidi.SMF.enums;assembly=libMidi"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Items Source -->
    <ObjectDataProvider x:Key="LanguagesComboSource" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="libQB:Languages"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="SMFEncodeComboSource" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="SMFEnum:SMFEncode"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="FilterSource" ObjectType="{x:Type SMF:SMFConverter}" MethodName="get_Def"/>
</ResourceDictionary>