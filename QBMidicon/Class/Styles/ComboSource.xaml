<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:libQB="clr-namespace:libQB.Enums;assembly=libQB"
    xmlns:local="clr-namespace:QBMidicon.Class.Enums"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ComboBox Source -->
    <ObjectDataProvider x:Key="LanguagesComboSource" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="libQB:Languages"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

    <!-- Transpose Combo Source -->
    <ObjectDataProvider x:Key="OctaveTransposeComboSource" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
        <ObjectDataProvider.MethodParameters>
            <x:Type TypeName="local:OctaveTranspose"/>
        </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>

</ResourceDictionary>